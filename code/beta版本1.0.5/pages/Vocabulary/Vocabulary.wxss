.content {
    /*“内容“的父级*/
    display: flex;
    flex-direction: column;
    align-items: center;
}

.content image {
    /*图片样式*/
    width: 228rpx;
    height: 228rpx;
    margin-top: 20%;
    margin-bottom: 17.06rpx;
}

.unrealInput {
    /*要进入二级菜单的搜索框样式*/
    width: 88.7vw;
    height: 40px;
    border: 1px solid #979797;
    border-radius: 6px;
    padding-left: 7px;
    display: flex;
    align-items: center;
    flex-direction: row;
    color: rgba(0, 0, 0, 0.5);
}

.result {
    display: flex;
    flex-direction: row;
    align-self: center;
    padding-bottom: 10px;
    margin-top: 2vw;
    width: 90vw;
    height: auto;
    border: 1px solid #979797;
    border-radius: 10px;
}

.resultList {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 12px;
    margin-left: 20px;
    margin-right: 20px;
}

.titleAndPlace {
    display: flex;
    flex-direction: column;
}

.searchContent_view_hide {  /*换一换页隐藏*/
    display: None;
}
  
.searchContent_view_show{  /*换一换页展示*/
    display: flex;
    flex-direction: column;
}

.titleAlign{
    font-size: 16px; 
    padding-top: 8px;
    font-weight: bold;
}

.titleContent{
    font-size: 14px; 
    padding-top: 1px;
}

.onChange{  /*换一换的样式*/
    font-size: 16px; 
    color: rgba(0, 0, 0, 0.5); 
    margin-left: 4vw; 
    display: flex; 
    flex-direction: row; 
    align-items: center;
}

.onChange :active{  /*按在换一换这个样式上不动*/
    background-color: rgba(0, 0, 0, 5%);
    border-radius: 6px;
}