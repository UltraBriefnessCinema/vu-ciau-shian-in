/*20221230写于松江昆冈乡_泖东小囡*/
.text_surface{  /*某个功能的外表*/
  width: 90%;
  background-color: white;
  box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.2);
  border-radius: 6px;
  margin-left: 5%;
  margin-top: 5px;
  padding-top: 10px;
  padding-bottom: 10px;
}

.text_title{  /*某个功能的标题*/
  font-size: 18px;
  font-weight: bold;
  margin-left: 5%;
}

.text_line{  /*某个功能标题与内容中间的分割线*/
  width: 90%;
  border-top: 1px solid #979797;
  margin: 5px 5% 5px 5%;
}

.text_content{  /*某个功能的内容*/
  font-size: 15px;
  color: rgba(0, 0, 0, 0.5);
  margin-left: 5%;
  text-align: left;
}