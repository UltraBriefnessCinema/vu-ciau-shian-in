/* pages/Jielong/Jielong.wxss */
.button_12_Surface{  /*12个县级按钮的表面*/
  background-color: white;
  border-radius: 6px;
  box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.1);
  padding: 1px 8px 1px 8px;
}

.button_12_Surface :active{
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 6px; 
}

.fontButton {
  font-size: 14px;
}

.radioPanel {
  width: 90vw; 
  height: auto; 
  background-color:white; 
  border-radius: 6px; 
  box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.1); 
  margin-left: 5vw; 
  padding-top: 5px; 
  padding-bottom: 5px;
  margin-top: 5px;
}

.BtnradioGroup{
  display: flex; 
