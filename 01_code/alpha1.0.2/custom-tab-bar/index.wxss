.tab-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  position: fixed;
  left: 18rpx;
  bottom: 66rpx; 
  width: 715rpx;
  height: 47px;
  background-color: #F3f3f3;
  border-radius: 10px;
  box-shadow: 3px 5px 11px -6px rgba(0, 0, 0, .50);  
  border: none;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}