/*Vocabulary-1.wxss*/
/*written by Mr.Gao in Xiaokunshan, Songjiang, Shanghai, China*/

.head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 5vw;
}

.searchButton {
  width: 58px;
  height: 40px;
  border: 1px solid #979797;
  border-radius: 6px;
  margin-left: 4px;
}

.searchButton :active{
  background-color: rgba(0, 0, 0, 5%);
  border-radius: 6px;
}

.input {
  display: flex;
  flex-direction: row;
  align-items: center;

  width: 265px;
  height: 40px;
  border: 1px solid #979797;
  border-radius: 6px;
}

.input input {
  padding-left: 4px;
  padding-right: 10px;
  width: 80vw;
  height: 40px;
  font-size: 16px;
}

.radio {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  margin-top: 10px;
}

.searchContent_view_show {
  display: flex;
  flex-direction: column;
}

.searchContent_view_hide {
  display: None;
}

.body {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  align-items: center;
}

.result {
  padding-bottom: 10px;
  margin-top: 13px;
  width: 88.7vw;
  height: auto;
  border: 1px solid #979797;
  border-radius: 10px;
}

.resultList {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 12px;
  margin-left: 20px;
  margin-right: 20px;
}

.titleAndPlace {
  display: flex;
  flex-direction: column;
}

.titleAlign {
  font-size: 16px;
  padding-top: 8px;
  font-weight: bold;
}

.titleContent {
  font-size: 14px;
  padding-top: 1px;
}

.iconSize {
  width: 30px;
}

.fontButton {
  font-size: 14px;
}

