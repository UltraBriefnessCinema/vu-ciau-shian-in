/* AboutUs.wxss */

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.content image {
  width: 31vw;
  height: 31vw;
  margin-bottom: 10px;
}

.aboutUs {
  margin-bottom: 32px;
  font-size: 19px;
  font-weight: bold;
  color: white;
}

.content-text {
  text-align: left;
  font-size: 19px;
  margin-top: 5px;
  margin-bottom: 5px;
  margin-left: 5%;
  margin-right: 5vw;
  line-height: 1.5;          /* 基础行高，会被内部段落覆盖 */
}

.cardStyle {
  width: 90vw;
  height: auto;
  background-color: white;
  border-radius: 6px;
  box-shadow: 0px 0px 5px rgba(0,0,0,0.1);
  padding-top: 10px;
  padding-bottom: 10px;
}

.showHideButton {
  background-color: white;
  padding: 4px 4vw;
  border-radius: 6px;
}

.showHideButton :active {
  background-color: rgba(0, 0, 0, 5%);
  border-radius: 6px;
}

/* ---------- 统一列表项与段落间距 ---------- */
.list-item {
  margin-bottom: 20rpx;       /* 条目之间的垂直间距 */
}

.list-para {
  line-height: 1.3;           /* 段落内部行距 */
  margin-bottom: 1.5vw;       /* 段落之间（软回车）的间距 */
}

.list-para:last-child {
  margin-bottom: 0;           /* 段落内最后一段不额外留白 */
}

/* 确保 content-text 内部的段落样式正确 */
.content-text .list-para {
  text-align: left;
  font-size: 19px;
}

.font-download-btn {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 999;
  background-color: rgba(44, 183, 72, 0.9); /* 与你的主题色 #2cb748 匹配 */
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.font-download-btn text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.font-actions {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 999;
  display: flex;
  gap: 16rpx;
}

.font-btn {
  background-color: rgba(44, 183, 72, 0.9);
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.font-btn.delete {
  background-color: rgba(255, 59, 48, 0.9);
}