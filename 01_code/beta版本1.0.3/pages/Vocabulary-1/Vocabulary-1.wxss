/*written by Mr.Gao in Xiaokunshan, Songjiang, Shanghai, China*/

.head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.input {
  display: flex;
  flex-direction: row;
  align-items: center;

  width: 88.7vw;
  height: 40px;
  border: 1px solid #979797;
  border-radius: 6px;
}

.input input {
  padding-left: 4px;
  padding-right: 10px;
  width: 80vw;
  height: 40px;
  font-size: 16px;
}

.radio {
  display: flex; 
  flex-direction: row; 
  align-items: center; 
  justify-content: flex-start; 
  margin-top: 10px;
}

.body {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  align-items: center;
}

.result {
  padding-bottom: 10px;
  margin-top: 13px;
  width: 88.7vw;
  height: auto;
  border: 1px solid #979797;
  border-radius: 10px;
}

.resultList {
  display: flex; 
  flex-direction: column; 
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 12px;
  margin-left: 20px;
  margin-right: 20px;
}

.titleAndPlace {
  display: flex;
  flex-direction: column;
}

.searchContent_view_hide {  /*内容页隐藏*/
  display: None;
}

.searchContent_view_show{  /*内容页展示*/
  display: flex;
  flex-direction: column;
}

.titleAlign{
  font-size: 16px; 
  padding-top: 8px;
  font-weight: bold;
}

.titleContent{
  font-size: 14px; 
  padding-top: 1px;
}