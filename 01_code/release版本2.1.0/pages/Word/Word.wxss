.content {  /*“内容“的父级*/
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20px;
}

.content image {  /*图片样式*/
  width: 31vw;
  height: 31vw;
}

.unrealInput {  /*要进入二级菜单的搜索框样式*/
  width: 90.4vw;
  height: 40px;
  border-radius: 6px;
  padding-left: 7px;
  display: flex; 
  align-items: center; 
  flex-direction: row; 
  color: rgba(0, 0, 0, 0.5);
  background-color: white;
  box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.1);
}

.button_Surface{
  background-color: white;
  border-radius: 6px;
  padding: 4px 4vw 4px 4vw;
  box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.1);
}

.button_Surface :active{
  background-color: rgba(0, 0, 0, 5%);
  border-radius: 6px;
  padding-top: 4px;
  padding-bottom: 4px;
}

.contentTitle{
  padding-top: 8px; 
  font-size: 16px; 
  font-weight: bold;
}

.refresh{
  width: 20px; 
  margin-left: 10px;
}

.refresh :active{
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 6px;
}

.contentContent{
  padding-top: 1px; 
  font-size: 14px;
}

.showContent{
  display: flex;
  flex-direction: column;
}

.cardSurface{
  width: 38vw;
  height: auto;
  background-color: white;
  border-radius: 6px;
  box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.1);
  margin-top: 5px;
  margin-left: 2.5px;
  margin-right: 2.5px;
  padding-left: 9px;
  padding-right: 9px;
  padding-top: 9px;
  padding-bottom: 9px;
}