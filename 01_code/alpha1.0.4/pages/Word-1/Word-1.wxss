.head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.input {
  display: flex;
  flex-direction: row;
  align-items: center;

  width: 88.7vw;
  height: 40px;
  border: 1px solid #979797;
  border-radius: 6px;
}

.input input {
  padding-left: 4px;
  padding-right: 10px;
  width: 80vw;
  height: 40px;
  font-size: 16px;
}


.body {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  align-items: center;
}

.result {
  padding-bottom: 10px;
  margin-top: 13px;
  width: 88.7vw;
  height: auto;
  border: 1px solid #979797;
  border-radius: 10px;
}

.iconImage {
  width: 22px; 
  height: 22px; 
  margin-left: 12px;
}